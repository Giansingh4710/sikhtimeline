        <mxCell id="g3HBGPiKNj88gW24iFQD-318" value="&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਭੰਗਾਣੀ ਦੀ ਜੰਗ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 14px;&quot;&gt;Battle of Bhangani (1685)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਹੋਲਾ ਮਹੱਲਾ ਦੀ ਅਰੰਭਤਾ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 14px;&quot;&gt;Holla Mohalla Started (1687)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਨਦੌਨ ਦੀ ਜੰਗ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 14px;&quot;&gt;Battle of Nadoun (1690)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਖਾਲਸਾ ਸਾਜਣਾ&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-family: Tahoma; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;font-family: Tahoma; background-color: transparent; font-size: 14px;&quot;&gt;Khalsa Sajnaa (1699)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਅਨੰਦਪੁਰ ਸਾਹਿਬ ਦੀ ਪਹਿਲੀ ਲੜਾਈ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 14px;&quot;&gt;First Battle of Anandpur Sahib (1700)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਅਨੰਦਪੁਰ ਸਾਹਿਬ ਦੀ ਚੌਥੀ ਲੜਾਈ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-family: Tahoma; background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;4th Battle of Anandpur Sahib (1704)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਬੰਦਾ ਬਹਾਦੁਰ ਨੂੰ ਸਿੰਘ ਸਜਾਣਾ&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Architects Daughter&amp;quot;; font-size: 12px;&quot;&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 14px;&quot;&gt;Banda Bahudur baptized (1707)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#062B70;fillStyle=solid;glass=0;shadow=0;align=left;strokeColor=none;dashed=1;dashPattern=1 1;whiteSpace=wrap;fontColor=#F4F4F4;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
          <mxGeometry x="-4665" y="2740.5" width="260" height="265" as="geometry" />
