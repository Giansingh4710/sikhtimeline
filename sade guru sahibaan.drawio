        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-163" value="&lt;div&gt;&lt;b style=&quot;text-wrap-mode: nowrap; font-family: raavi;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਹਰਿਕਿਸ਼ਨ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੬੫੬, ਕੀਰਤਪੁਰ ਸਾਹਿਬ,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੬੬੧, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੬੬੪, ਦਿੱਲੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਸ੍ਰੀ ਗੁਰੂ ਹਰਿ ਰਾਇ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਕ੍ਰਿਸ਼ਨ ਕੌਰ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-825" y="1705" width="410" height="100" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-164" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;font-family: raavi; font-size: 25px; text-wrap-mode: nowrap;&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਤੇਗ ਬਹਾਦਰ ਜੀ&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੬੨੧, ਗੁਰੂ ਕੇ ਮਹਿਲ, ਅੰਮ੍ਰਿਤਸਰ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੬੬੪, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੬੭੫, ਦਿੱਲੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਸ੍ਰੀ ਗੁਰੂ ਹਰਿਗੋਬਿੰਦ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਨਾਨਕੀ ਜੀ, &lt;b&gt;ਮਹਿਲ &lt;/b&gt;ਮਾਤਾ ਗੁਜਰੀ ਜੀ&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਬਾਣੀ&lt;/b&gt;: ੧੫ ਰਾਗਾਂ ਵਿੱਚ ੫੯ ਸ਼ਬਦ, ੫੭ ਸ਼ਲੋਕ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-825" y="1855" width="410" height="125" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-165" value="&lt;div&gt;&lt;font&gt;&lt;b style=&quot;text-wrap-mode: nowrap; font-family: raavi;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਗੋਬਿੰਦ ਸਿੰਘ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੬੬੬, ਪਟਨਾ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੬੭੫, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੭੦੮, ਹਜ਼ੂਰ ਸਾਹਿਬ, ਨਾਂਦੇੜ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਸ੍ਰੀ ਗੁਰੂ ਤੇਗ ਬਹਾਦਰ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਗੁਜਰੀ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਮਹਿਲ&lt;/b&gt;: ਮਾਤਾ ਜੀਤ ਕੌਰ ਜੀ, ਮਾਤਾ ਸੁੰਦਰ ਕੌਰ ਜੀ, ਮਾਤਾ ਸਾਹਿਬ ਕੌਰ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਬਾਣੀ&lt;/b&gt;: ਜਾਪ ਸਾਹਿਬ, ਸਵੱਈਏ, ਚੌਪਈ ਸਾਹਿਬ, ਅਕਾਲ ਉਸਤਤਿ, ਬਚਿੱਤਰ ਨਾਟਕ, ਸ਼ਬਦ ਹਜ਼ਾਰੇ, ਜ਼ਫਰਨਾਮਾ, ਸ੍ਰੀ ਦਸਮ ਗ੍ਰੰਥ ਸਾਹਿਬ, ਸ੍ਰੀ ਸਰਬ ਲੋਹ ਗ੍ਰੰਥ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-825" y="2055" width="410" height="180" as="geometry" />
        </mxCell>
