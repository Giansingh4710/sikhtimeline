        <mxCell id="g3HBGPiKNj88gW24iFQD-310" value="&lt;h1 style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 101px;&quot; face=&quot;raavi&quot;&gt;ਸਾਡੇ ਗੁਰੂ ਸਾਹਿਬਾਨ&lt;/font&gt;&lt;/h1&gt;" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFFFFF;fillStyle=solid;align=center;strokeColor=default;strokeWidth=4;gradientColor=none;verticalAlign=middle;labelBorderColor=none;labelBackgroundColor=none;textShadow=0;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
