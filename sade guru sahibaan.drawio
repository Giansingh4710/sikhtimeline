        <mxCell id="g3HBGPiKNj88gW24iFQD-141" value="&lt;div style=&quot;line-height: 130%;&quot;&gt;&lt;div&gt;&lt;b style=&quot;font-family: &amp;quot;Architects Daughter&amp;quot;; text-align: left; text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 31px; line-height: 130%;&quot; face=&quot;raavi&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਨਾਨਕ ਦੇਵ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px; line-height: 130%;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੪੬੯, ਰਾਇ ਭੋਇ ਦੀ ਤਲਵੰਡੀ (ਨਨਕਾਣਾ ਸਾਹਿਬ)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;line-height: 150%; font-size: 17px;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੫੩੯, ਕਰਤਾਰਪੁਰ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;line-height: 150%; font-size: 17px;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਕਲਿਆਣ ਚੰਦ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਤ੍ਰਿਪਤਾ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;line-height: 150%; font-size: 17px;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਮਹਿਲ &lt;/b&gt;ਮਾਤਾ ਸੁਲੱਖਣੀ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;line-height: 150%; font-size: 17px;&quot; face=&quot;raavi&quot;&gt;&lt;b style=&quot;&quot;&gt;ਬਾਣੀ&lt;/b&gt;: ਜਪੁਜੀ, ਸਿਧ ਗੋਸਟਿ, ਦਖਣੀ ਓਅੰਕਾਰ, ਸਿਧ ਗੋਸਟਿ, ਮਾਝ ਕੀ ਵਾਰ, ਮਲਾਰ ਕੀ ਵਾਰ, ਬਾਰਹ ਮਾਹਾ ਤੁਖਾਰੀ, ਪਟੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;line-height: 150%; font-size: 17px;&quot; face=&quot;raavi&quot;&gt;੧੯ ਰਾਗਾਂ ਵਿੱਚ ੯੭੪ ਸ਼ਬਦ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;gradientDirection=radial;perimeterSpacing=1;shadowColor=#000000;labelPadding=0;shadowOffsetX=2;strokeOpacity=100;dropTarget=0;whiteSpace=wrap;spacing=0;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
          <mxGeometry x="-825" y="63" width="410" height="226" as="geometry" />
        </mxCell>
        <mxCell id="g3HBGPiKNj88gW24iFQD-142" value="&lt;div&gt;&lt;div&gt;&lt;b style=&quot;font-family: &amp;quot;Architects Daughter&amp;quot;; text-align: left; text-wrap-mode: nowrap; background-color: transparent;&quot;&gt;&lt;font&gt;&lt;font style=&quot;font-size: 31px;&quot; face=&quot;raavi&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਅੰਗਦ ਦੇਵ ਜੀ&lt;/font&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px;&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੫੦੪, ਮੱਤੇ ਦੀ ਸਰ੍ਹਾਂ, ਮੁਕਤਸਰ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੫੩੯, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੫੫੨, ਖਡੂਰ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਬਾਬਾ ਫੇਰੂ ਮੱਲ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਦਯਾ ਕੌਰ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b&gt;ਮਹਿਲ &lt;/b&gt;ਮਾਤਾ ਖੀਵੀ ਜੀ&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ਬਾਣੀ&lt;/b&gt;: ੬੩ ਸਲੋਕ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
          <mxGeometry x="-825" y="381" width="410" height="189" as="geometry" />
        </mxCell>
        <mxCell id="g3HBGPiKNj88gW24iFQD-143" value="&lt;div&gt;&lt;b style=&quot;font-family: &amp;quot;Architects Daughter&amp;quot;; text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 31px;&quot; face=&quot;raavi&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਅਮਰਦਾਸ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੪੭੯, ਬਾਸਰਕੇ, ਅੰਮ੍ਰਿਤਸਰ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੫੫੨, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੫੭੪, ਗੋਇੰਦਵਾਲ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਤੇਜ ਭਾਨ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਸੁਲੱਖਣੀ (ਲਛਮੀ) ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b&gt;ਮਹਿਲ &lt;/b&gt;ਮਾਤਾ ਮਨਸਾ ਦੇਵੀ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ਬਾਣੀ&lt;/b&gt;: ਅਨੰਦ ਸਾਹਿਬ, ੧੭ ਵਾਰਾਂ ਰਚਨਾ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;੧੭ ਰਾਗਾਂ ਵਿੱਚ ੯੦੭ ਸ਼ਬਦ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
          <mxGeometry x="-825" y="715" width="410" height="205" as="geometry" />
        </mxCell>
        <mxCell id="g3HBGPiKNj88gW24iFQD-144" value="&lt;div&gt;&lt;b style=&quot;font-family: raavi; text-align: left; text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 31px;&quot;&gt;&amp;nbsp; ਸ੍ਰੀ ਗੁਰੂ ਰਾਮਦਾਸ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੫੩੪, ਚੂਨਾ ਮੰਡੀ, ਲਾਹੌਰ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੫੭੪, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੫੮੧, ਗੋਇੰਦਵਾਲ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਹਰਿਦਾਸ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਦਯਾ ਕੌਰ ਜੀ, &lt;b&gt;ਮਹਿਲ &lt;/b&gt;ਬੀਬੀ ਭਾਨੀ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;line-height: 150%; font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ਬਾਣੀ&lt;/b&gt;: ਲਾਵਾਂ, ਵਡਹੰਸ ਕੀ ਵਾਰ, ੩੦ ਰਾਗਾਂ ਵਿੱਚ ੬੭੯ ਸ਼ਬਦ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
          <mxGeometry x="-830" y="1020" width="420" height="155" as="geometry" />
        </mxCell>
        <mxCell id="g3HBGPiKNj88gW24iFQD-145" value="&lt;div&gt;&lt;font&gt;&lt;b style=&quot;text-wrap-mode: nowrap; font-family: raavi;&quot;&gt;&lt;font style=&quot;font-size: 31px;&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਅਰਜਨ ਦੇਵ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੫੬੩, ਗੋਇੰਦਵਾਲ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੫੮੧, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੬੦੬, ਡੇ੍ਹਰਾ ਸਾਹਿਬ, ਲਾਹੌਰ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਸ੍ਰੀ ਗੁਰੂ ਰਾਮ ਦਾਸ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਬੀਬੀ ਭਾਨੀ ਜੀ,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਮਹਿਲ&lt;/b&gt; ਮਾਤਾ ਗੰਗਾ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਬਾਣੀ&lt;/b&gt;: ਸੁਖਮਨੀ ਸਾਹਿਬ, ਬਾਰਹ ਮਾਹਾ ਮਾਝ, ਬਸੰਤ ਕੀ ਵਾਰ, ਬਾਵਨ ਅਖਰੀ, ਜੈਤਸਰੀ ਕੀ ਵਾਰ, ਰਾਗਮਾਲਾ, ੩੦ ਰਾਗਾਂ ਵਿੱਚ ੨੨੧੮ ਸ਼ਬਦ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
          <mxGeometry x="-825" y="1311" width="410" height="209" as="geometry" />
        </mxCell>
