        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-138" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;background-color: transparent; font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;b style=&quot;&quot;&gt;ਪਿਆਰੇ ਭਾਈ ਦਯਾ ਸਿੰਘ ਜੀ &lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;font-family: Garamond; font-size: 16px; background-color: transparent;&quot;&gt;|&amp;nbsp;&lt;b&gt;Pyare&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;font-family: Garamond; font-size: 16px; background-color: transparent;&quot;&gt;Bhai Daya Singh Ji&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;font style=&quot;&quot;&gt;(1669 - 1708)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="rounded=1;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#062B70;fillStyle=solid;glass=0;shadow=0;align=left;strokeColor=default;verticalAlign=middle;fontSize=12;fontColor=#FFFFFF;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-2209.82" y="2461" width="370" height="20" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-139" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;font-family: raavi; font-size: 15px; text-align: center;&quot;&gt;ਪਿਆਰੇ ਭਾਈ ਧਰਮ ਸਿੰਘ ਜੀ&amp;nbsp;&lt;/b&gt;&lt;font style=&quot;&quot; face=&quot;Garamond&quot;&gt;&lt;font&gt;&lt;font style=&quot;&quot;&gt;|&lt;/font&gt;&amp;nbsp;&lt;b&gt;Pyare&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;b style=&quot;&quot;&gt;Bhai Dharam Singh Ji&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;font style=&quot;&quot;&gt;(1666 - 1708)&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;" style="rounded=1;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#062B70;fillStyle=solid;glass=0;shadow=0;align=left;strokeColor=default;verticalAlign=middle;fontSize=12;fontColor=#FFFFFF;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-2240" y="2481" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-140" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;background-color: transparent; font-size: 15px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ਭਾਈ ਤਾਰੂ ਸਿੰਘ ਜੀ &lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;font-family: Garamond; font-size: 16px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;|&amp;nbsp;&lt;/font&gt;&lt;b style=&quot;font-family: Garamond; font-size: 16px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Bhai Taru Singh Ji &lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;(1720 - 1745)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" style="rounded=1;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFC833;fillStyle=solid;glass=0;shadow=0;align=left;strokeColor=default;verticalAlign=middle;fontSize=12;fontColor=#000000;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-1700" y="2310" width="250" height="20" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-141" value="&lt;div style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;font-family: &amp;quot;Architects Daughter&amp;quot;; font-size: 25px; text-align: left; text-wrap-mode: nowrap;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਨਾਨਕ ਦੇਵ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੪੬੯, ਰਾਇ ਭੋਇ ਦੀ ਤਲਵੰਡੀ (ਨਨਕਾਣਾ ਸਾਹਿਬ)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੫੩੯, ਕਰਤਾਰਪੁਰ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਕਲਿਆਣ ਚੰਦ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਤ੍ਰਿਪਤਾ ਜੀ, &lt;b&gt;ਮਹਿਲ &lt;/b&gt;ਮਾਤਾ ਸੁਲੱਖਣੀ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਬਾਣੀ&lt;/b&gt;: ਜਪੁਜੀ, ਸਿਧ ਗੋਸਟਿ, ਦਖਣੀ ਓਅੰਕਾਰ, ਸਿਧ ਗੋਸਟਿ, ਮਾਝ ਕੀ ਵਾਰ, ਮਲਾਰ ਕੀ ਵਾਰ, ਬਾਰਹ ਮਾਹਾ ਤੁਖਾਰੀ, ਪਟੀ, ੧੯ ਰਾਗਾਂ ਵਿੱਚ ੯੭੪ ਸ਼ਬਦ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;gradientDirection=radial;perimeterSpacing=1;shadowColor=#000000;labelPadding=0;shadowOffsetX=2;strokeOpacity=100;dropTarget=0;whiteSpace=wrap;spacing=0;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-825" y="70" width="410" height="145" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-142" value="&lt;div&gt;&lt;b style=&quot;font-family: &amp;quot;Architects Daughter&amp;quot;; text-align: left; text-wrap-mode: nowrap; background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਅੰਗਦ ਦੇਵ ਜੀ&lt;/font&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੫੦੪, ਮੱਤੇ ਦੀ ਸਰ੍ਹਾਂ, ਮੁਕਤਸਰ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੫੩੯, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੫੫੨, ਖਡੂਰ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਬਾਬਾ ਫੇਰੂ ਮੱਲ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਦਯਾ ਕੌਰ ਜੀ, &lt;b&gt;ਮਹਿਲ &lt;/b&gt;ਮਾਤਾ ਖੀਵੀ ਜੀ&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ਬਾਣੀ&lt;/b&gt;: ੬੩ ਸਲੋਕ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-825" y="315" width="410" height="130" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-143" value="&lt;div&gt;&lt;b style=&quot;font-family: &amp;quot;Architects Daughter&amp;quot;; font-size: 25px; text-align: left;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਅਮਰਦਾਸ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੪੭੯, ਬਾਸਰਕੇ, ਅੰਮ੍ਰਿਤਸਰ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੫੫੨, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੫੭੪, ਗੋਇੰਦਵਾਲ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਤੇਜ ਭਾਨ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਸੁਲੱਖਣੀ (ਲਛਮੀ) ਜੀ, &lt;b&gt;ਮਹਿਲ &lt;/b&gt;ਮਾਤਾ ਮਨਸਾ ਦੇਵੀ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ਬਾਣੀ&lt;/b&gt;: ਅਨੰਦ ਸਾਹਿਬ, ੧੭ ਵਾਰਾਂ ਰਚਨਾ, ੧੭ ਰਾਗਾਂ ਵਿੱਚ ੯੦੭ ਸ਼ਬਦ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-825" y="560" width="410" height="130" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-144" value="&lt;div&gt;&lt;b style=&quot;font-family: raavi; font-size: 25px; text-align: left; text-wrap-mode: nowrap;&quot;&gt;&amp;nbsp; ਸ੍ਰੀ ਗੁਰੂ ਰਾਮਦਾਸ ਜੀ&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੫੩੪, ਚੂਨਾ ਮੰਡੀ, ਲਾਹੌਰ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੫੭੪, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੫੮੧, ਗੋਇੰਦਵਾਲ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਹਰਿਦਾਸ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਦਯਾ ਕੌਰ ਜੀ, &lt;b&gt;ਮਹਿਲ &lt;/b&gt;ਬੀਬੀ ਭਾਨੀ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਬਾਣੀ&lt;/b&gt;: ਲਾਵਾਂ, ਵਡਹੰਸ ਕੀ ਵਾਰ, ੩੦ ਰਾਗਾਂ ਵਿੱਚ ੬੭੯ ਸ਼ਬਦ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-830" y="785" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-145" value="&lt;div&gt;&lt;font&gt;&lt;b style=&quot;text-wrap-mode: nowrap; font-family: raavi;&quot;&gt;&lt;font style=&quot;font-size: 25px;&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਅਰਜਨ ਦੇਵ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੫੬੩, ਗੋਇੰਦਵਾਲ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੫੮੧, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੬੦੬, ਡੇ੍ਹਰਾ ਸਾਹਿਬ, ਲਾਹੌਰ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਸ੍ਰੀ ਗੁਰੂ ਰਾਮ ਦਾਸ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਬੀਬੀ ਭਾਨੀ ਜੀ, &lt;b&gt;ਮਹਿਲ&lt;/b&gt; ਮਾਤਾ ਗੰਗਾ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;ਬਾਣੀ&lt;/b&gt;: ਸੁਖਮਨੀ ਸਾਹਿਬ, ਬਾਰਹ ਮਾਹਾ ਮਾਝ, ਬਸੰਤ ਕੀ ਵਾਰ, ਬਾਵਨ ਅਖਰੀ, ਜੈਤਸਰੀ ਕੀ ਵਾਰ, ਰਾਗਮਾਲਾ, ੩੦ ਰਾਗਾਂ ਵਿੱਚ ੨੨੧੮ ਸ਼ਬਦ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-825" y="995" width="410" height="150" as="geometry" />
        </mxCell>
