        <mxCell id="g3HBGPiKNj88gW24iFQD-161" value="&lt;div&gt;&lt;font&gt;&lt;b style=&quot;font-family: &amp;quot;Architects Daughter&amp;quot;; text-wrap-mode: nowrap;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 31px;&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਹਰਿਗੋਬਿੰਦ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੫੯੫, ਗੁਰੂ ਕੀ ਵਡਾਲੀ, ਅੰਮ੍ਰਿਤਸਰ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੬੦੬, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੬੪੪, ਕੀਰਤਪੁਰ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਸ੍ਰੀ ਗੁਰੂ ਅਰਜਨ ਦੇਵ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਗੰਗਾ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਮਹਿਲ&lt;/b&gt;: ਮਾਤਾ ਦਮੋਦਰੀ ਜੀ, ਮਾਤਾ ਨਾਨਕੀ ਜੀ, ਮਾਤਾ ਮਹਾਦੇਵੀ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
          <mxGeometry x="-825" y="1656" width="410" height="159" as="geometry" />
        </mxCell>
        <mxCell id="g3HBGPiKNj88gW24iFQD-162" value="&lt;div&gt;&lt;font style=&quot;font-size: 31px;&quot;&gt;&lt;b style=&quot;font-family: raavi; text-wrap-mode: nowrap;&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਹਰਿਰਾਇ ਜੀ&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੬੩੦, ਕੀਰਤਪੁਰ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੬੪੪, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੬੬੧, ਕੀਰਤਪੁਰ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਬਾਬਾ ਗੁਰਦਿੱਤਾ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਨਿਹਾਲ ਕੌਰ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਮਹਿਲ &lt;/b&gt;ਮਾਤਾ ਕ੍ਰਿਸ਼ਨ ਕੌਰ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
          <mxGeometry x="-830" y="2036" width="420" height="154" as="geometry" />
        </mxCell>
        <mxCell id="g3HBGPiKNj88gW24iFQD-163" value="&lt;div&gt;&lt;b style=&quot;text-wrap-mode: nowrap; font-family: raavi;&quot;&gt;&lt;font style=&quot;font-size: 31px;&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਹਰਿਕਿਸ਼ਨ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੬੫੬, ਕੀਰਤਪੁਰ ਸਾਹਿਬ,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੬੬੧, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੬੬੪, ਦਿੱਲੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਸ੍ਰੀ ਗੁਰੂ ਹਰਿ ਰਾਇ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਕ੍ਰਿਸ਼ਨ ਕੌਰ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
          <mxGeometry x="-825" y="2270" width="410" height="125" as="geometry" />
        </mxCell>
        <mxCell id="g3HBGPiKNj88gW24iFQD-164" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;font-family: raavi; text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 31px;&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਤੇਗ ਬਹਾਦਰ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੬੨੧, ਗੁਰੂ ਕੇ ਮਹਿਲ, ਅੰਮ੍ਰਿਤਸਰ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੬੬੪, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੬੭੫, ਦਿੱਲੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਸ੍ਰੀ ਗੁਰੂ ਹਰਿਗੋਬਿੰਦ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਨਾਨਕੀ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਮਹਿਲ &lt;/b&gt;ਮਾਤਾ ਗੁਜਰੀ ਜੀ&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 17px; line-height: 150%;&quot;&gt;&lt;b&gt;ਬਾਣੀ&lt;/b&gt;: ੧੫ ਰਾਗਾਂ ਵਿੱਚ ੫੯ ਸ਼ਬਦ, ੫੭ ਸ਼ਲੋਕ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
          <mxGeometry x="-825" y="2453" width="410" height="177" as="geometry" />
        </mxCell>
        <mxCell id="g3HBGPiKNj88gW24iFQD-165" value="&lt;div&gt;&lt;font&gt;&lt;b style=&quot;text-wrap-mode: nowrap; font-family: raavi;&quot;&gt;&lt;font style=&quot;font-size: 31px;&quot;&gt;ਸ੍ਰੀ ਗੁਰੂ ਗੋਬਿੰਦ ਸਿੰਘ ਜੀ&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px; line-height: 150%;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਪ੍ਰਕਾਸ਼&lt;/b&gt;: ੧੬੬੬, ਪਟਨਾ ਸਾਹਿਬ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px; line-height: 150%;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਗੁਰਗੱਦੀ&lt;/b&gt;: ੧੬੭੫, &lt;b&gt;ਜੋਤੀ ਜੋਤਿ&lt;/b&gt;: ੧੭੦੮, ਹਜ਼ੂਰ ਸਾਹਿਬ, ਨਾਂਦੇੜ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px; line-height: 150%;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਪਿਤਾ &lt;/b&gt;ਸ੍ਰੀ ਗੁਰੂ ਤੇਗ ਬਹਾਦਰ ਜੀ, &lt;b&gt;ਮਾਤਾ &lt;/b&gt;ਗੁਜਰੀ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px; line-height: 150%;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਮਹਿਲ&lt;/b&gt;: ਮਾਤਾ ਜੀਤ ਕੌਰ ਜੀ, ਮਾਤਾ ਸੁੰਦਰ ਕੌਰ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px; line-height: 150%;&quot; face=&quot;raavi&quot;&gt;ਮਾਤਾ ਸਾਹਿਬ ਕੌਰ ਜੀ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px; line-height: 150%;&quot; face=&quot;raavi&quot;&gt;&lt;b&gt;ਬਾਣੀ&lt;/b&gt;: ਜਾਪ ਸਾਹਿਬ, ਸਵੱਈਏ, ਚੌਪਈ ਸਾਹਿਬ, ਅਕਾਲ ਉਸਤਤਿ, ਬਚਿੱਤਰ ਨਾਟਕ, ਸ਼ਬਦ ਹਜ਼ਾਰੇ, ਜ਼ਫਰਨਾਮਾ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 17px; line-height: 150%;&quot; face=&quot;raavi&quot;&gt;ਸ੍ਰੀ ਦਸਮ ਗ੍ਰੰਥ ਸਾਹਿਬ, ਸ੍ਰੀ ਸਰਬ ਲੋਹ ਗ੍ਰੰਥ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#E6C873;fontColor=#062B70;strokeColor=none;gradientColor=none;glass=0;shadow=1;fillStyle=auto;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;gradientDirection=radial;shadowOffsetX=2;shadowColor=#000000;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
