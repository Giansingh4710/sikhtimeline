        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-320" value="&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਹਰਿਮੰਦਰ ਸਾਹਿਬ ਦੀ ਨੀਂਹ &lt;/font&gt;&lt;/span&gt;&lt;font face=&quot;Tahoma&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;| Foundation of&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;Tahoma&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Harmandir Sahib (1589)&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਤਰਨ ਤਾਰਨ ਵਸਾਇਆ&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;| Established&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Taran Taaran (1596)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਆਦਿ ਗ੍ਰੰਥ ਜੀ ਦੀ ਬੀੜ ਤਿਆਰ ਹੋੇਈ&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;| Aad&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Granth Ji completed (1604)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#6AA3FF;fillStyle=solid;align=left;strokeColor=none;dashed=1;dashPattern=1 1;verticalAlign=top;fontColor=#FFFFFF;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-4665" y="1054" width="260" height="118" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-321" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;ਸ੍ਰੀ ਅਕਾਲ ਤਖਤ ਸਾਹਿਬ ਉਸਾਰਿਆ&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-family: Tahoma; background-color: transparent;&quot;&gt;|&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;font-family: Tahoma; background-color: transparent; font-size: 14px;&quot;&gt;Established Sri Akal Takht Sahib (1609)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;ਗਵਾਲੀਅਰ ਕਿਲ੍ਹੇ ਵਿਚ&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;At&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;Gwalior Fort&amp;nbsp; (1611-1612)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਪਿਪਲੀ ਸਾਹਿਬ ਦਾ ਜੰਗ&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;Battle at Pipli Sahib (1628)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਸ੍ਰੀ ਹਰਿਗੋਬਿੰਦਪੁਰ ਦੀ ਜੰਗ&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;Battle at Sri Harbobindpur (1630)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਮਹਿਰਾਜ ਦਾ ਜੰਗ&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;Battle at Mehraj (1631)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਕਰਤਾਰਪੁਰ ਦਾ ਜੰਗ&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;Battle at Kartarpur (1634)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#4C8CFF;fillStyle=solid;glass=0;shadow=0;align=left;strokeColor=none;dashed=1;dashPattern=1 1;verticalAlign=top;fontColor=#FFFFFF;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
