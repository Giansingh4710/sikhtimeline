        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-132" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;background-color: transparent; font-size: 15px;&quot;&gt;&lt;b style=&quot;&quot;&gt;ਭਾਈ ਜੀਵਨ ਸਿੰਘ (ਭਾਈ ਜੈਤਾ) ਜੀ &lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;font-family: Garamond; font-size: 16px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;|&amp;nbsp;&lt;/font&gt;&lt;b style=&quot;font-family: Garamond; font-size: 16px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Bhai Jiwan Singh Ji (1661 - 1704)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#FFC833;fillStyle=solid;glass=0;shadow=0;align=left;strokeColor=default;verticalAlign=middle;fontSize=12;fontColor=#000000;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-2290" y="2570" width="430" height="20" as="geometry" />
