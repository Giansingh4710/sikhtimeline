        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-131" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;background-color: transparent; font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;b style=&quot;&quot;&gt;ਭਾਈ ਦਯਾਲਾ ਜੀ &lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;font-family: Garamond; font-size: 16px; background-color: transparent;&quot;&gt;|&amp;nbsp;&lt;/font&gt;&lt;b style=&quot;font-family: Garamond; font-size: 16px; background-color: transparent;&quot;&gt;Bhai Dayala Ji (&lt;/b&gt;&lt;b style=&quot;font-family: Garamond; font-size: 16px; background-color: transparent;&quot;&gt;1643&lt;/b&gt;&lt;b style=&quot;font-family: Garamond; font-size: 16px; background-color: transparent;&quot;&gt;&amp;nbsp;- 1675)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#0F3E9E;fillStyle=solid;glass=0;shadow=0;align=left;strokeColor=default;fontColor=#FFFFFF;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
