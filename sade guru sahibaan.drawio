        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-315" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot; face=&quot;raavi&quot;&gt;&lt;b style=&quot;&quot;&gt;੪੦ ਮੁਕਤੇ&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;ਮਹਾਂ ਸਿੰਘ, ਸ਼ਮੀਰ ਸਿੰਘ, ਸਾਧ ਸਿੰਘ, ਗਰਜਾ ਸਿੰਘ, ਸਹੇਲ ਸਿੰਘ, ਸੁਲਤਾਨ ਸਿੰਘ, ਸੌਭਾ ਸਿੰਘ, ਸੰਤ ਸਿੰਘ, ਹਰਸ਼ਾਂ ਸਿੰਘ, ਹਰੀ ਸਿੰਘ, ਕਰਨ ਸਿੰਘ, ਕਰਮ ਸਿੰਘ, ਕਾਲਾ ਸਿੰਘ, ਕਿਰਤ ਸਿੰਘ, ਕ੍ਰਿਪਾਲ ਸਿੰਘ, ਖੁਸ਼ਹਾਲ ਸਿੰਘ, ਗੁਲਾਬ ਸਿੰਘ, ਗੰਗਾ ਸਿੰਘ, ਗੰਡਾ ਸਿੰਘ, ਘਰਬਾਰਾ ਸਿੰਘ, ਚੰਬਾ ਸਿੰਘ, ਜਾਦੋ ਸਿੰਘ, ਜੋਗਾ ਸਿੰਘ, ਜੰਗ ਸਿੰਘ, ਦਿਆਲ ਸਿੰਘ, ਦਰਬਾਰਾ ਸਿੰਘ, ਦਿਲਬਾਗ ਸਿੰਘ, ਧਰਮ ਸਿੰਘ, ਧੰਨਾ ਸਿੰਘ, ਨਿਹਾਲ ਸਿੰਘ, ਨਿਧਾਨ ਸਿੰਘ, ਭਾਗ ਸਿੰਘ, ਬੂੜ ਸਿੰਘ, ਭੋਗਾ ਸਿੰਘ, ਭੋਲਾ ਸਿੰਘ, ਮੱਜਾ ਸਿੰਘ, ਮਾਨ ਸਿੰਘ, ਮੈਯਾ ਸਿੰਘ, ਰਾਏ ਸਿੰਘ, ਲਛਮਨ ਸਿੰਘ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#062B70;fillStyle=solid;align=center;strokeColor=default;strokeWidth=2;arcSize=6;spacingLeft=8;fontColor=#F4F4F4;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-3556.5" y="2064.12" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-316" value="&lt;font face=&quot;raavi&quot; style=&quot;background-color: initial;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;ਭਾਈ ਲਹਿਣਾ ਜੀ ਦਾ ਗੁਰੂ ਨਾਨਕ ਦੇਵ ਜੀ ਨਾਲ ਮਿਲਾਪ&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px; font-family: Tahoma;&quot;&gt;| Bhai Lehna Ji&#39;s first meet with Guru Nanak Dev Ji (1532)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#C9DFFF;fillStyle=solid;align=left;strokeColor=none;dashed=1;dashPattern=1 1;fontColor=#0D0D0D;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-4665" y="420" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-317" value="&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਸੰਤੋਖਸਰ ਦੀ ਖੁਦਵਾਈ ਅਰੰਭੀ&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;font face=&quot;Tahoma&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;| Digging&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;Tahoma&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;started of &#39;Santokh-sar&#39; (1570)&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;ਗੁਰੂ ਕਾ ਚੱਕ&#39; ਵਸਾਇਆ&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;Established &#39;Guru Ka Chak&#39; (1572)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਅੰਮ੍ਰਿਤਸਰ ਸਰੋਵਰ ਦੀ ਤਿਆਰੀ ਅਰੰਭੀ&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;Planning of Amritsar Sarovar (1577)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਸ੍ਰੀ ਚੰਦ ਜੀ ਨਾਲ ਮੇਲ&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px; font-family: Tahoma;&quot;&gt;Meeting with Baba Sri Chand Ji&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#8EBBFF;fillStyle=solid;align=left;strokeColor=none;dashed=1;dashPattern=1 1;verticalAlign=top;fontColor=#0F0F0F;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-4665" y="787" width="257" height="158" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-318" value="&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਭੰਗਾਣੀ ਦੀ ਜੰਗ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 14px;&quot;&gt;Battle of Bhangani (1685)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਹੋਲਾ ਮਹੱਲਾ ਦੀ ਅਰੰਭਤਾ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 14px;&quot;&gt;Holla Mohalla Started (1687)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਨਦੌਨ ਦੀ ਜੰਗ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 14px;&quot;&gt;Battle of Nadoun (1690)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਖਾਲਸਾ ਸਾਜਣਾ&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-family: Tahoma; background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;font-family: Tahoma; background-color: transparent; font-size: 14px;&quot;&gt;Khalsa Sajnaa (1699)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਅਨੰਦਪੁਰ ਸਾਹਿਬ ਦੀ ਪਹਿਲੀ ਲੜਾਈ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 14px;&quot;&gt;First Battle of Anandpur Sahib (1700)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਅਨੰਦਪੁਰ ਸਾਹਿਬ ਦੀ ਚੌਥੀ ਲੜਾਈ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-family: Tahoma; background-color: transparent; font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;4th Battle of Anandpur Sahib (1704)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਬੰਦਾ ਬਹਾਦੁਰ ਨੂੰ ਸਿੰਘ ਸਜਾਣਾ&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Architects Daughter&amp;quot;; font-size: 12px;&quot;&gt;&lt;span style=&quot;font-family: Tahoma;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 14px;&quot;&gt;Banda Bahudur baptized (1707)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#062B70;fillStyle=solid;glass=0;shadow=0;align=left;strokeColor=none;dashed=1;dashPattern=1 1;whiteSpace=wrap;fontColor=#F4F4F4;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-4665" y="2013.5" width="260" height="265" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-319" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਸ੍ਰੀ ਗੁਰੂ ਅੰਗਦ ਦੇਵ ਜੀ ਦੀ ਸੇਵਾ ਵਿੱਚ&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Tahoma; background-color: transparent;&quot;&gt;| &lt;/span&gt;&lt;span style=&quot;font-family: Tahoma; background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Service&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-family: Tahoma; background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&amp;nbsp; to Sri&amp;nbsp;Guru Angad Dev Ji (1541-1552)&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 13px; font-family: Tahoma; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਗੋਇੰਦਵਾਲ ਵਸਾਇਆ&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px; font-family: Tahoma;&quot;&gt;Established Goindwal (1549)&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&lt;font face=&quot;raavi&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; ਬਾਉਲੀ ਸਾਹਿਬ ਦੀ ਉਸਾਰੀ &lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; font-family: Tahoma;&quot;&gt;| Bowli Sahib&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; font-family: Tahoma;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;Construction (1559 - 1564)&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#AECFFF;fillStyle=solid;align=left;strokeColor=none;dashed=1;dashPattern=1 1;fontColor=#0E0E0E;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
