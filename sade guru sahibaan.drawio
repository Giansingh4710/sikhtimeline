        <mxCell id="g3HBGPiKNj88gW24iFQD-316" value="&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;background-color: initial;&quot;&gt;&lt;span style=&quot;font-size: 14px; line-height: 100%;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;ਭਾਈ ਲਹਿਣਾ ਜੀ ਦਾ ਗੁਰੂ ਨਾਨਕ ਦੇਵ ਜੀ ਨਾਲ ਮਿਲਾਪ&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px; font-family: Tahoma; line-height: 100%;&quot;&gt;| Bhai Lehna Ji&#39;s first meet with Guru Nanak Dev Ji (1532)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#C9DFFF;fillStyle=solid;align=left;strokeColor=none;dashed=1;dashPattern=1 1;fontColor=#0D0D0D;" parent="g3HBGPiKNj88gW24iFQD-1" vertex="1">
