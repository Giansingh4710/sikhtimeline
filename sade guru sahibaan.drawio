        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-312" value="&lt;div&gt;&lt;p data-start=&quot;234&quot; data-end=&quot;360&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;strong data-start=&quot;234&quot; data-end=&quot;250&quot; style=&quot;&quot;&gt;ਪਹਿਲੀ ਉਦਾਸੀ:&amp;nbsp;&lt;/strong&gt;ਭਾਈ ਲਾਲੋ, ਆਸਾ ਕੀ ਵਾਰ ਉਚਾਰਨ, ਹਰਦੁਆਰ, ਭਗਤ ਰਵਿਦਾਸ ਜੀ ਅਤੇ ਭਗਤ ਕਬੀਰ ਜੀ ਨਾਲ ਮੇਲ, ਪਟਨਾ ਸਾਹਿਬ, ਨੂਰ ਸ਼ਾਹ ਉਧਾਰਨ, ਆਰਤੀ&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;234&quot; data-end=&quot;360&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;strong data-start=&quot;362&quot; data-end=&quot;377&quot; style=&quot;background-color: transparent;&quot;&gt;ਦੂਜੀ ਉਦਾਸੀ:&amp;nbsp;&lt;/strong&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;ਰਾਜਾ ਸ਼ਿਵਨਾਭ (ਲੰਕਾ), ਕੌੜਾ ਰਾਕਸ਼, ਨਾਨਕ ਜੀਰਾ, ਭਗਤ ਧੰਨਾ ਜੀ ਨਾਲ ਮੇਲ&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;445&quot; data-end=&quot;494&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;strong data-start=&quot;445&quot; data-end=&quot;461&quot;&gt;ਤੀਸਰੀ ਉਦਾਸੀ:&amp;nbsp;&lt;/strong&gt;ਸਿੱਧਾ ਨਾਲ ਗੋਸ਼ਟੀ, ਨੇਪਾਲ, ਤਿੱਬਤ&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;496&quot; data-end=&quot;612&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot; face=&quot;raavi&quot;&gt;&lt;strong data-start=&quot;496&quot; data-end=&quot;511&quot; style=&quot;&quot;&gt;ਚੌਥੀ ਉਦਾਸੀ:&amp;nbsp;&lt;/strong&gt;ਬਾਬਾ ਫ਼ਰੀਦ ਜੀ (ਸ਼ੇਖ ਬ੍ਰਹਮ) ਨਾਲ ਮੇਲ, ਸਜਣ ਠੱਗ, ਮੱਕਾ, ਮਦੀਨਾ, ਬਗਦਾਦ, ਪੰਝਾ ਸਾਹਿਬ, ਐਮਨਾਬਾਦ, ਬਾਬਰ ਨਾਲ ਮੇਲ&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#E6F0FF;fillStyle=solid;align=left;strokeColor=default;glass=0;shadow=1;strokeWidth=2;spacingLeft=8;spacingTop=4;spacingBottom=4;spacingRight=4;verticalAlign=middle;arcSize=6;imageHeight=24;gradientColor=none;fontColor=#0D0D0D;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-2597" y="50" width="390" height="190" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-313" value="&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;੨੨ ਮੰਜੀਆਂ&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 16px;&quot;&gt;ਰੰਗ ਦਾਸ, ਰੰਗ ਸ਼ਾਹ, ਭਾਈ ਲਾਲੂ, ਸਾਵਣ ਮੱਲ ਜੀ, ਹਿੰਦਾਲ ਜੀ, ਸਚ ਨਿਸਚ, ਰਾਜਾ ਰਾਮ ਜੀ, ਭਾਈ ਪਾਰੋ ਜੁਲਕਾ, ਭਾਈ ਸਾਧਾਰਣ, ਪ੍ਰਿਥੀਮਲ ਜੀ ਸੇਵਾ ਹਿਤਕਾਰੀ, ਅਲ੍ਹਾ ਯਾਰ ਖਾਂ ਪਠਾਣ, ਖੇਡਾਂ, ਕੇਦਾਰੀ, ਦਰਬਾਰੀ, ਮਾਈ ਦਾਸ, ਮਥੋ-ਮੁਗਰੀ, ਮਾਣਕ ਚੰਦ, ਗੰਗੂ ਸ਼ਾਹ-ਦਿੱਲੀ, ਫੇਰਾ ਜੀ, ਬੂਆ ਜੀ, ਬੈਣੀ ਜੀ, ਮੁਰਾਰੀ&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#AECFFF;fillStyle=solid;align=left;strokeColor=default;glass=0;shadow=1;strokeWidth=2;arcSize=6;spacingLeft=8;spacingRight=2;fontColor=#0E0E0E;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-2599.32" y="560" width="395" height="120" as="geometry" />
        </mxCell>
        <mxCell id="CTDWZ7_SoCDcn1SdTo_g-314" value="&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;ਪਹਿਲੀ ਉਦਾਸੀ&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Tahoma&quot;&gt;|&amp;nbsp; 1st Udasi (1501)&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;raavi&quot; style=&quot;background-color: initial; font-size: 13px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;ਦੂਸਰੀ ਉਦਾਸੀ&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 14px; background-color: initial;&quot; face=&quot;Tahoma&quot;&gt;|&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Tahoma&quot;&gt;2nd Udasi (1510)&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px; background-color: initial;&quot; face=&quot;Tahoma&quot;&gt;&lt;b style=&quot;background-color: transparent; font-family: raavi; font-size: 13px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;ਤੀਸਰੀ ਉਦਾਸੀ&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/b&gt;|&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 14px; background-color: transparent;&quot; face=&quot;Tahoma&quot;&gt;3rd Udasi (1514)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;font style=&quot;background-color: initial;&quot; face=&quot;Tahoma&quot;&gt;&lt;b style=&quot;background-color: transparent; font-family: raavi; font-size: 13px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;ਚੌਥੀ ਉਦਾਸੀ&amp;nbsp; &amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/b&gt;|&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;font face=&quot;Tahoma&quot;&gt;4th Udasi (1518)&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;hachureGap=4;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fillColor=#E6F0FF;fillStyle=solid;glass=0;shadow=0;align=left;strokeColor=none;perimeterSpacing=0;dashed=1;gradientColor=none;gradientDirection=radial;dashPattern=1 1;verticalAlign=middle;fontColor=#0D0D0D;" parent="CTDWZ7_SoCDcn1SdTo_g-1" vertex="1">
          <mxGeometry x="-4665" y="170" width="260" height="85" as="geometry" />
